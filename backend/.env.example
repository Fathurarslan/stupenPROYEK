DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=kelurahan_sidoharjo

PORT=5000

# Isi "true" HANYA kalau server berjalan di belakang proxy (Nginx, Railway,
# Render, Cloudflare). Salah setelan membuka celah di dua arah: diisi true
# padahal tanpa proxy -> header X-Forwarded-For bisa dipalsukan untuk menembus
# rate limit; dibiarkan kosong padahal ada proxy -> semua pengunjung terbaca
# sebagai satu IP dan ikut terkunci bersama-sama.
TRUST_PROXY=false

# Alamat situs yang boleh memanggil API ini dari browser, pisahkan dengan koma.
# Kalau dikosongkan, yang dipakai adalah alamat pengembangan bawaan
# (localhost dan 127.0.0.1 pada port 5173 dan 4173).
#
# WAJIB diisi alamat situs sebenarnya saat dipasang di server. Kalau lupa,
# situsnya tetap terbuka tapi seluruh datanya kosong, dan alasannya hanya
# terlihat di console browser -- server akan mencatat peringatan "CORS menolak
# asal ..." di terminal, jadi periksa log backend kalau itu terjadi.
CORS_ORIGIN=

# Dipakai sekali oleh "npm run db:seed" untuk membuat baris admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Kunci penanda tangan JWT, minimal 32 karakter. Bikin sendiri per lingkungan dengan:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_SECONDS=28800
